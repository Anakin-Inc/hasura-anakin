# Real Anakin API — get a free key at https://anakin.io/dashboard (500 credits,
# no card required). Point this at a mock server (e.g. the WireMock stack in
# ../registry-entry/tests/) for local/CI runs instead of a live key.
ANAKIN_SERVER_URL=https://api.anakin.io/v1
ANAKIN_API_KEY=

# Optional — defaults shown match config/config.yaml's `value:` fallbacks.
ANAKIN_TIMEOUT=30
ANAKIN_RETRY_TIMES=1
ANAKIN_RETRY_DELAY=1000
